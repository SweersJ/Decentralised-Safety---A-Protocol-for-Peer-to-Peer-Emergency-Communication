{
  "name": "quint-vscode-highlighting",
  "displayName": "Quint Syntax Highlighting",
  "description": "Syntax highlighting and language configuration for the Quint specification language.",
  "version": "0.0.1",
  "publisher": "sweersj",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "quint",
    "formal verification",
    "tla",
    "syntax"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sweersj/quint-vscode-highlighting"
  },
  "contributes": {
    "languages": [
      {
        "id": "quint",
        "aliases": [
          "Quint",
          "quint"
        ],
        "extensions": [
          ".qnt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quint",
        "scopeName": "source.quint",
        "path": "./syntaxes/quint.tmLanguage.json"
      }
    ]
  }
}
