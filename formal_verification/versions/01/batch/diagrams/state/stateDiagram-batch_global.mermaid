---
config:
  layout: elk
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
    cycleBreakingStrategy: INTERACTIVE
---
stateDiagram-v2
    [*] --> Init
    Init --> Idle
    Idle --> Idle
    Idle --> SenderAddedMessages
    SenderAddedMessages --> SenderSentPayload
    SenderSentPayload --> SenderSentPayloadInTransit
    SenderSentPayloadInTransit --> ReceiverReceivedPayload
    ReceiverReceivedPayload --> ReceiverProcessing

    state ReceiverProcessing {
        [*] --> ReceiverStoredMessages
        ReceiverStoredMessages --> [*]
        --
        [*] --> ReceiverDeterminedAck
        ReceiverDeterminedAck --> [*]
    }

    ReceiverProcessing --> ReceiverSentAck
    ReceiverSentAck --> ReceiverSentAckInTransit
    ReceiverSentAckInTransit --> SenderReceivedAck
    SenderReceivedAck --> Idle